  "private": true,
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "author": {
    "name": "Vulchi Vijaya Kumar",
    "email": "customercare@aerosunenergy.in",
    "url": "https://aerosunenergy.in"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "npm run clean:cache && node scripts/report-google-integrations.mjs",
    "build": "next build",
    "clean:cache": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true }); require('node:fs').rmSync('tsconfig.tsbuildinfo', { force: true })\"",
    "db:migrate": "node scripts/migrate-database.mjs",
    "google:index-check": "node scripts/submit-indexnow.js",
    "postbuild": "node scripts/submit-indexnow.js --non-blocking",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "audit:prod": "npm audit --omit=dev",
    "branchsync": "git pull & git checkout main & git pull origin main & git checkout developer & git fetch origin & git reset --hard origin/main & git push --force-with-lease origin developer"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.6",
    "mongodb": "^7.9.0",
    "next": "^16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.92.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/third-parties": "16.4.6",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "postcss": "^8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "typescript": "^6.0.3"
  }
}